 "how_to_stack": {
  "note": "Every file in cards/ is a 500x700 transparent PNG on the same canvas. Draw them at (0,0) in this order; skip any layer the card doesn't have.",
  "order": [
   "base (card_blank | stone | safe | cobra_tail | card_back)",
   "center (pip_<suit>, face_<J|Q|K>_<suit>, face_A_<suit>; face_joker for the Joker) - omit for enhanced cards, EXCEPT the Joker keeps face_joker",
   "mod_wash/<mod> (full-bleed)",
   "mod_frame/<mod>",
   "mod_emblem/<mod> (directional: *_arrow_up, rotate per facing)",
   "rank/<rank>_<black|red> (Joker: rank/JKR)",
   "suit_corner/<suit> (Joker: none)",
   "finish/* (NEW: Prism or Metal, see finishes) - over the face, under hazards",
   "hazard/*",
   "special/*",
   "rider/* (Joker: rider/joker_x2)",
   "bosses: boss/<name>_card (no title, corners clear) -> rank -> suit_corner -> boss/boss_frame. boss/<name>_card_titled bakes the name in for menus/reveals and should NOT get rank/suit layers"
  ],
  "fire_levels": "suggested A-J:1, 10-7:2, 6-4:3, 3-2:4",
  "icons": "relics/ and provisions/: glyph/, frame/, framed/. 256x256 transparent.",
  "mod_colors": {
   "mult": "#8f4a34",
   "chip": "#4b6272",
   "plus": "#5e7447",
   "minus": "#83403a",
   "bumper": "#9a6b40",
   "gold": "#b38c3e",
   "wild": "#644a70",
   "lucky": "#56703f"
  },
  "changelog": [
   "r2: clubs seam closed (pip_clubs, suit_corner/clubs, face_*_clubs, ui/suit_clubs regenerated)",
   "r2: added center/face_A_<suit> x4",
   "r2: corner suits drawn as halo pass + ink pass (no internal halo lines)",
   "r2: boss/<name>_card no longer bakes the title (it collided with the corner index); titled copies are boss/<name>_card_titled",
   "r3: Joker skin (center/face_joker, mod_wash/joker, mod_frame/joker, rank/JKR, rider/joker_x2)",
   "r3: new finish/ group: Prism (foil, sheen, glint) and Metal (plate, pin, pin hole, glint, lift 1-3)",
   "r3: new fx/ group: card_glare, card_shadow_soft",
   "r3: relic_frame/epic; relics chuck_wagon (epic), swimming_goggles (rare); relic_framed/second_wind_spent",
   "r3: provision shell_game",
   "r3: icon/sleeve, sleight, laser, watch (rider signatures)",
   "r3: retired relics weathervane + magnifying_glass (files removed)",
   "r3: ui/signature_toggle_{selected,unselected,unselected_hover} (+@2x) for the rider signature selector"
  ]
 },
 "joker": {
  "stack": [
   "base/card_blank",
   "mod_wash/joker",
   "center/face_joker",
   "mod_frame/joker",
   "rank/JKR",
   "finish/* (if any)",
   "rider/joker_x2"
  ],
  "note": "Suitless: no suit_corner. Harlequin skin (oxblood + coal diamonds, clear centre) so a Joker never reads as Lucky green. rank/JKR_red is an alternate if you want the red-ink index. The ×2 badge is the only baked text in this update."
 },
 "finishes": {
  "family_note": "A finish is a full-card overlay separate from enhancements (like an edition). Draw finish layers after suit_corner and before hazard. Future finishes: add finish/<name>_* following the same pattern (one full-bleed texture + small FX sprites).",
  "prism": {
   "layers": [
    "finish/prism_foil (static, full-bleed, already clipped to the card)",
    "finish/prism_sheen (slide along the main diagonal, clip with the card shape e.g. base/card_blank alpha; blend add or screen ~0.6)",
    "finish/prism_glint (64 px; spawn 2 at random points, scale 0->1->0 over 0.6 s, rotate 45°)"
   ],
   "sheen_anim": "translate from (-500,-700) to (+500,+700) over 1.8 s, pause 1.2 s, repeat"
  },
  "metal": {
   "layers": [
    "finish/metal_plate (opaque brushed steel with windows over both rank corners and the bottom-left enhancement badge)",
    "finish/metal_pin x4 at pin_centers",
    "finish/metal_pin_hole replaces each popped pin",
    "finish/metal_glint (narrow band; sweep on hover or on score)",
    "finish/metal_lift_1..3 (700x900 canvas, card at offset 100,100) for the cover pop"
   ],
   "pin_centers_px": [
    [
     38,
     38
    ],
    [
     462,
     38
    ],
    [
     38,
     662
    ],
    [
     462,
     662
    ]
   ],
   "pin_size_px": 48,
   "windows_px": {
    "rank_corner_top_left": [
     28,
     64,
     92,
     180
    ],
    "rank_corner_bottom_right": "same rect rotated 180° around the card centre",
    "badge_bottom_left_circle": [
     92,
     612,
     38
    ]
   },
   "states": {
    "4 pins": "plate + 4 pins",
    "3..1": "plate + pins + holes",
    "0 (4th play)": "play metal_lift_1..3 (60 ms each) then drop the plate; normal card",
    "5th play": "clears"
   }
  }
 },
 "fx_note": {
  "card_glare": "500x700, move with the cursor across the tilted card (clip to card shape, blend add ~0.5).",
  "card_shadow_soft": "600x800, card shape at offset (50,50). Shift opposite to the tilt.",
  "tilt": "Safe to ~20°: no hairlines at the card edge in the new layers (frame lines sit 7+ px in)."
 },
