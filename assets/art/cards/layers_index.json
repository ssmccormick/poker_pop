 "how_to_stack": {
  "note": "Every file in cards/ is a 500x700 transparent PNG on the same canvas. Draw them at (0,0) in this order; skip any layer the card doesn't have.",
  "order": [
   "base (card_blank | stone | safe | cobra_tail | card_back)",
   "center (pip_<suit> or face_<J|Q|K>_<suit>) - omit when the card has a mod",
   "mod_wash/<mod> (full-bleed, corners included)",
   "mod_frame/<mod>",
   "mod_emblem/<mod> (plus/minus/bumper: *_arrow_up, rotate 90 deg per facing around the card center)",
   "rank/<rank>_<black|red> (bone halo + drop shadow baked in, reads on any wash)",
   "suit_corner/<suit> (same halo + shadow)",
   "hazard/*",
   "special/*",
   "rider/*",
   "boss/boss_frame on top of boss/<name>_card"
  ],
  "fire_levels": "fire_1 at Ace..fire_4 at rank 2: suggested A-J:1, 10-7:2, 6-4:3, 3-2:4",
  "wind": "hazard/wind emblem + hazard/wind_arrow_up rotated to the blow direction (hide it without Weathervane)",
  "bomb": "hazard/bomb + hazard/bomb_alert_ring + hazard/bomb_fuse_badge_<n>",
  "safe": "base/safe has 4 empty digit windows; draw combo digits in-engine (Oswald 600, #e6d5b0)",
  "icons": "relics/ and provisions/: glyph/, frame/, framed/. 256x256 transparent.",
  "mod_colors": {
   "mult": "#8f4a34",
   "chip": "#4b6272",
   "plus": "#5e7447",
   "minus": "#83403a",
   "bumper": "#9a6b40",
   "gold": "#b38c3e",
   "wild": "#644a70",
   "lucky": "#56703f"
  }
